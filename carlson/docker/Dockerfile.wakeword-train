# Image d'entraînement du wake word "Hey Carlson" via nanowakeword.
#
# Build  : docker build -f carlson/docker/Dockerfile.wakeword-train -t butlr-wakeword-train .
# Run    : voir scripts/train-wakeword.sh
#
# ~ Taille image : ~4-6 GB (PyTorch + audio deps).
# GPU   : passer --gpus all au docker run si NVIDIA Container Toolkit installé.

FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget ffmpeg libsndfile1 espeak-ng \
    && rm -rf /var/lib/apt/lists/*

# ~ nanowakeword[train] tire torch 2.8.x, torchaudio, scipy, sklearn, onnx,
#   acoustics, librosa, pydub, audiomentations, soundfile, etc.
RUN pip install --no-cache-dir "nanowakeword[train]>=2.0"

COPY carlson/docker/train.py /train.py

# /data monté depuis carlson/assets/wakeword/ :
#   - lecture  : training_config.yaml, clips réels si présents
#   - écriture : hey_carlson.onnx (sortie)
VOLUME ["/data"]

WORKDIR /work

ENTRYPOINT ["python", "/train.py"]
